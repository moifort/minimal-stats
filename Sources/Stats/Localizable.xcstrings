    },
    "This will remove the login item and move the app to the Trash.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stats ne s'ouvrira plus à la connexion et l'app sera placée dans la corbeille."
