    "The download did not come from GitHub over HTTPS.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement ne venait pas de GitHub en HTTPS."
          }
        }
      }
    },
    "The downloaded app is not Stats.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app téléchargée n'est pas Stats."
          }
        }
      }
    },
    "The downloaded app is not newer than the installed one.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app téléchargée n'est pas plus récente que celle installée."
          }
        }
      }
    },
    "The downloaded app is not properly signed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app téléchargée n'est pas correctement signée."
          }
