        }
      }
    },
    "Data read and written over the last %@, by your own apps only: macOS does not report it for system processes": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données lues et écrites sur %@, par vos propres apps seulement : macOS ne les donne pas pour les processus système"
